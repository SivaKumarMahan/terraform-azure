# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
location             = "centralindia"
resource_group_name  = "rg-web-dev"
prefix               = "web-dev"
admin_ssh_public_key = "ssh-ed25519 AAAA... you@laptop" # cat ~/.ssh/id_ed25519.pub
alert_email          = "ops-team@example.com"

waf_mode = "Prevention"
vm_sku   = "Standard_B2s"
instance_count = {
  minimum = 2
  default = 2
  maximum = 6
}
